# BEGIN N2jet — managed by 2djet/deploy.sh (do not edit by hand)
    # Flat URL: https://themithrilcompany.com/N2jet.html
    location = /N2jet.html {
        alias /var/www/N2jet/N2jet.html;
        default_type text/html;
        add_header Cache-Control "no-cache";
    }

    location = /n2jet.html {
        alias /var/www/N2jet/N2jet.html;
        default_type text/html;
        add_header Cache-Control "no-cache";
    }
# END N2jet
